+pub(crate) fn drop_layout_wrappers(doc: &mut BaseDocument, container: usize) {
+    let previous = doc.nodes[container]
+        .layout_children
+        .borrow_mut()
+        .take()
+        .unwrap_or_default();
+    for id in previous {
+        let Some(node) = doc.nodes.get(id) else {
+            continue;
+        };
+        let is_pseudo = node
+            .parent
+            .and_then(|parent| doc.nodes.get(parent))
+            .is_some_and(|parent| parent.before == Some(id) || parent.after == Some(id));
+        if !node.is_anonymous() || is_pseudo || node.layout_parent.get() != Some(container) {
+            continue;
+        }
+        crate::mutator::clear_removed_interaction(id, doc);
+        let wrapper = doc.nodes.remove(id);
+        // Wrapped DOM children survive; bypass the old wrapper until reconstruction.
+        for child in wrapper.children {
+            if let Some(child) = doc.nodes.get_mut(child) {
+                if child.layout_parent.get() == Some(id) {
+                    child.layout_parent.set(wrapper.layout_parent.get());
+                }
+            }
+        }
     }
 }
 
