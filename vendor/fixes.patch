+pub(crate) fn clear_removed_interaction(node_id: usize, doc: &mut BaseDocument) {
+    // Clear interaction handles while their nodes and layout ancestors still exist.
+    if doc.hover_node_id == Some(node_id) {
+        for id in doc.maybe_node_layout_ancestors(doc.hover_node_id) {
+            doc.snapshot_node_and(id, |node| node.unhover());
+        }
+        doc.hover_node_id = None;
+    }
+    if doc.focus_node_id == Some(node_id) {
+        doc.clear_focus();
+    }
+    if doc.active_node_id == Some(node_id) {
+        doc.unactive_node();
+    }
+    if doc.mousedown_node_id == Some(node_id) {
+        doc.mousedown_node_id = None;
+    }
+}
